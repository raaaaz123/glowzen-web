# Environment for the AI plan builder (/tools/face-yoga-plan).
#
# Copy to .env.local for development, and set the same four names in the Vercel
# project settings for production. Everything else on this site is static and
# needs none of this — without these vars the plan builder still answers, it
# just falls back to a fixed starting routine and says so on the page.
#
# Server-only. Never rename any of these with a NEXT_PUBLIC_ prefix: that would
# inline the secret key into the browser bundle.

# The Bedrock region the model is enabled in.
AWS_REGION=us-east-1

# IAM user with bedrock:InvokeModel on the model below. Same credentials the
# Rexa Ai backend uses.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Any Bedrock model id reachable through the Converse API. Swapping this is the
# whole migration if Kimi is ever replaced — see lib/ai/bedrock.ts.
BEDROCK_MODEL_ID=moonshotai.kimi-k2.5

# Optional. Ceiling on one reply; the plan builder needs very little, since the
# model returns a small JSON object rather than the routine itself.
# BEDROCK_MAX_TOKENS=900
